{
  "name": "@u18/admin-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "approval:status": "node scripts/admin-approval.mjs status",
    "approval:list": "node scripts/admin-approval.mjs list",
    "approval:grant": "node scripts/admin-approval.mjs grant",
    "approval:revoke": "node scripts/admin-approval.mjs revoke",
    "migrate:local": "wrangler d1 migrations apply u18-admin --local",
    "migrate:remote": "wrangler d1 migrations apply u18-admin --remote"
  },
  "dependencies": {
    "@u18/admin-db": "workspace:*",
    "@u18/contracts": "workspace:*",
    "@u18/domain": "workspace:*",
    "@u18/web-ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
