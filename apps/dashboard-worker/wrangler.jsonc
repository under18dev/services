{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "u18-dashboard",
  "main": "src/index.ts",
  // @cloudflare/vitest-pool-workers が抱える workerd のビルド日より後の日付を
  // 指定すると、テスト起動時に ERR_FUTURE_COMPATIBILITY_DATE で落ちる。
  // 上げるときは vitest-pool-workers / miniflare も一緒に上げること。
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // auth-worker の IdentityRPC だけを束縛する。
  // D1 の binding は意図的に持たない —— 認証 DB の書き込み権限は
  // auth-worker に集約する（仕様書 2.2）。
  "services": [
    {
      "binding": "IDENTITY",
      "service": "u18-auth",
      "entrypoint": "IdentityRPC",
    },
  ],

  "vars": {
    "AUTH_ISSUER": "http://localhost:8787",
    "ENVIRONMENT": "development",
  },

  // 本番用の上書き。auth-worker と同じ理由で、既定値のまま deploy しないこと。
  "env": {
    "production": {
      "services": [
        {
          "binding": "IDENTITY",
          // `wrangler deploy --env production` は Worker 名を
          // "<name>-<env>" に派生させるため、本番の auth-worker は
          // "u18-auth-production" になる。ここを "u18-auth" のままにすると、
          // 本番 dashboard が development 設定の auth-worker に黙って
          // 繋がりうる（OTP がログに出る、Cookie から __Host-/Secure が外れる）。
          //
          // 逆に auth 側の env.production で "name": "u18-auth" と固定する手も
          // あるが、それだと --env を付け忘れた deploy が本番を上書きできて
          // しまうので採らない。
          "service": "u18-auth-production",
          "entrypoint": "IdentityRPC",
        },
      ],
      // auth-worker と同一ホストの /account/* だけを受け持つ（#33）。
      // __Host- セッション Cookie は発行ホストにしか送られないため、
      // dashboard を別ホストに置くとログイン状態を読めない。
      // Cloudflare は route をより長い pattern 優先で解決するので、
      // auth 側の auth.under18.dev/* より先にここが拾う。
      //
      // **この pattern の "/account" は src/base-path.ts の
      // ACCOUNT_BASE_PATH と一致していなければならない**（#106）。
      // Cloudflare は一致した接頭辞を URL から取り除かないので、
      // Worker には /account/api/me がそのまま届く。ハンドラ側を
      // 接頭辞なしで登録すると本番で全エンドポイントが 404 になる。
      // ここを変えるときは必ず ACCOUNT_BASE_PATH も変えること。
      "routes": [{ "pattern": "auth.under18.dev/account/*", "zone_name": "under18.dev" }],

      "vars": {
        "AUTH_ISSUER": "https://auth.under18.dev",
        "ENVIRONMENT": "production",
      },
    },
  },
}
