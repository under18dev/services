{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "u18-dashboard",
  "main": "src/index.ts",
  // 3 つの Worker で同じ値にすること。仕様書の日付に揃えてある（#108）。
  //
  // テストが使う workerd が知らない日付を指定すると、テスト起動時に
  // ERR_FUTURE_COMPATIBILITY_DATE で全滅する（wrangler dev は通るので気づきにくい）。
  //
  // **上限は workerd のビルド日ではない。** 実測では workerd 1.20261019.1
  // （2026-10-19 ビルド）が 2026-10-24 まで受け付け、2026-10-25 で落ちる。
  // **いまの値は上限ちょうどで、余裕がゼロである。** vitest-plugin が
  // より古い workerd を抱える版に変わると、こちらが何も変えていないのに
  // テストが全滅する（README「固定しているバージョンとその理由」）。
  // 進めるときは @cloudflare/vitest-plugin を先に上げ、実際に pnpm test で
  // 確かめること。
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  // アカウント画面のクライアントアイランドは生成物で、リポジトリに入って
  // いない（auth-worker と同じ理由。ソースと食い違ったバンドルが本番へ
  // 出るのを防ぐ）。
  //
  // **package.json の dev / build / typecheck / test だけでは足りない。**
  // CI の deploy ジョブは `pnpm exec wrangler deploy` を直接呼ぶので
  // npm スクリプトを迂回し、本番デプロイが
  //   Could not resolve "./generated/account-island.bundle"
  // で落ちる。**実際に落ちた**（auth-worker が #132 で踏んだのと同じ形を、
  // dashboard で繰り返した）。生成を Worker のビルド定義に置けば、
  // dev / deploy / dry-run のどの経路から入っても必ず走る。
  //
  // watch_dir を island のソースだけに絞る。既定の監視範囲は src 全体で、
  // 出力（src/presentation/http/ui/generated/）もその中にあるため、
  // 生成 -> 変更検知 -> 再生成 が無限に続いて `wrangler dev` が
  // 起動しなくなる（#138）。deploy / dry-run は watch しないので、
  // 絞っても「どの経路から入っても必ず走る」は保たれる。
  "build": {
    "command": "node scripts/build-client.mjs",
    "watch_dir": "src/presentation/http/ui/client",
  },

  "observability": { "enabled": true },

  // auth-worker の IdentityRPC だけを束縛する。
  // D1 の binding は意図的に持たない —— 認証 DB の書き込み権限は
  // auth-worker に集約する（仕様書 2.2）。
  "services": [
    {
      "binding": "IDENTITY",
      "service": "u18-auth",
      "entrypoint": "IdentityRPC",
    },
  ],

  "vars": {
    "AUTH_ISSUER": "http://localhost:8787",
    "ENVIRONMENT": "development",
  },

  // 本番用の上書き。auth-worker と同じ理由で、既定値のまま deploy しないこと。
  "env": {
    "production": {
      "services": [
        {
          "binding": "IDENTITY",
          // `wrangler deploy --env production` は Worker 名を
          // "<name>-<env>" に派生させるため、本番の auth-worker は
          // "u18-auth-production" になる。ここを "u18-auth" のままにすると、
          // 本番 dashboard が development 設定の auth-worker に黙って
          // 繋がりうる（OTP がログに出る、Cookie から __Host-/Secure が外れる）。
          //
          // 逆に auth 側の env.production で "name": "u18-auth" と固定する手も
          // あるが、それだと --env を付け忘れた deploy が本番を上書きできて
          // しまうので採らない。
          "service": "u18-auth-production",
          "entrypoint": "IdentityRPC",
        },
      ],
      // auth-worker と同一ホストの /account/* だけを受け持つ（#33）。
      // __Host- セッション Cookie は発行ホストにしか送られないため、
      // dashboard を別ホストに置くとログイン状態を読めない。
      // Cloudflare は route をより長い pattern 優先で解決するので、
      // auth 側の auth.under18.dev/* より先にここが拾う。
      //
      // **この pattern の "/account" は src/base-path.ts の
      // ACCOUNT_BASE_PATH と一致していなければならない**（#106）。
      // Cloudflare は一致した接頭辞を URL から取り除かないので、
      // Worker には /account/api/me がそのまま届く。ハンドラ側を
      // 接頭辞なしで登録すると本番で全エンドポイントが 404 になる。
      // ここを変えるときは必ず ACCOUNT_BASE_PATH も変えること。
      "routes": [{ "pattern": "auth.under18.dev/account/*", "zone_name": "under18.dev" }],

      "vars": {
        "AUTH_ISSUER": "https://auth.under18.dev",
        "ENVIRONMENT": "production",
      },
    },
  },
}
