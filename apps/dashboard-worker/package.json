{
  "name": "@u18/dashboard-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-client.mjs && wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build-client.mjs && wrangler deploy --dry-run --outdir dist",
    "typecheck": "node scripts/build-client.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node scripts/build-client.mjs && vitest run",
    "cf-typegen": "wrangler types",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@u18/contracts": "workspace:*",
    "@u18/domain": "workspace:*",
    "@u18/web-ui": "workspace:*",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@u18/testing": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3"
  }
}
