{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "u18-auth",
  "main": "src/index.ts",
  // テストが使う workerd が知らない日付を指定すると、テスト起動時に
  // ERR_FUTURE_COMPATIBILITY_DATE で全滅する（wrangler dev は通るので気づきにくい）。
  //
  // **上限は workerd のビルド日ではない。** 実測では workerd 1.20261019.1
  // （2026-10-19 ビルド）が 2026-10-24 を受け付け、2026-11-15 で落ちる。
  // 進めるときは @cloudflare/vitest-plugin を先に上げ、実際に pnpm test で
  // 確かめること（#108）。
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],

  // ログイン画面のクライアントアイランドは生成物で、リポジトリに入っていない
  // （#36: ソースと食い違ったバンドルが本番へ出るのを防ぐため）。
  // package.json の dev / build / typecheck / test は生成を前に挟んでいるが、
  // **deploy は挟んでおらず、CI は `pnpm exec wrangler deploy` を直接呼ぶので
  // スクリプト自体を迂回する。** 実際それで本番デプロイが
  //   Could not resolve "./generated/login-island.bundle"
  // で落ちた。生成を npm スクリプトではなく Worker のビルド定義に置くことで、
  // dev / deploy / dry-run のどの経路から入っても必ず走るようにする。
  // watch_dir を island のソースだけに絞る。既定の監視範囲は src 全体で、
  // このビルドの出力 (src/presentation/http/ui/generated/login-island.bundle.ts)
  // もその中にあるため、生成 -> 変更検知 -> 再生成 が無限に続いて
  // `wrangler dev` が一度も起動しない（25 秒で 40 回リビルドした）。
  // deploy / dry-run は watch しないので、watch_dir を絞っても
  // 「どの経路から入っても必ず走る」という #132 の意図は保たれる。
  "build": {
    "command": "node scripts/build-client.mjs",
    "watch_dir": "src/presentation/http/ui/client",
  },
  "observability": { "enabled": true },

  // Identity D1 の所有者は auth-worker だけ（仕様書 2.2）。
  // 他の Worker にこの binding を付けないこと。
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "u18-identity",
      // `wrangler d1 create u18-identity` の出力で置き換える。
      "database_id": "b63c7ee9-42d8-40f2-8f02-e6b5b867eb55",
      "migrations_dir": "../../packages/db/drizzle",
    },
  ],

  // Cloudflare Email Sending（仕様書 14-3 の決定 / #35）。
  // Email Routing の同名バインディングとは別物で、任意の宛先へ送れる。
  // `wrangler dev` では既定でシミュレートされ、ログ出力のみで実送信しない。
  // 実送信したい場合だけ "remote": true を足す（実在の宛先に届くので注意）。
  // 制限キー（`allowed_destination_addresses` 等）を**意図的に置かない**。
  // 制限しないことが「任意の宛先へ送る」設定で、公式ドキュメントの最初の例もこの形。
  //
  // ## 任意の宛先へ送るには 2 つ前提がある
  //
  // 1. **送信ドメインの onboarding。** 済ませる前は「検証済み宛先」にしか送れない。
  // 2. **Workers Paid プラン。** Free では outbound sending が "Not available"。
  //    月 3,000 通まで込み、超過は $0.35 / 1,000 通。
  //    検証済み宛先への送信はどのプランでも無料で quota にも乗らないため、
  //    **Free のまま開発を続けると本番で初めて落ちる。**
  //
  // ## エラーコードの罠（実際に踏んだ）
  //
  // onboarding 前に送ると **`E_RECIPIENT_NOT_ALLOWED`** が返る。しかし公式ドキュメントは
  // このコードを「宛先が `allowed_destination_addresses` に無い」と説明している。
  // **我々はそのキーを設定していないので、文書どおりならこのコードは出ないはず**で、
  // 「存在しない allowlist」を探して時間を溶かすことになる。
  // 未 onboarding 専用の `E_SENDER_DOMAIN_NOT_AVAILABLE` が別にあるのに使い分けられていない。
  //
  // このコードを見たら、まず **Email Sending が有効化され、ドメインが
  // onboarding 済みか**を疑うこと（ダッシュボードの Email Service → Sending）。
  "send_email": [{ "name": "EMAIL" }],

  // レート制限（#21、仕様書 9 Abuse）。
  //
  // **`period` は 10 か 60 しか取れない。** つまりここで止められるのは
  // 「短時間に大量」までで、「60 秒ごとに 1 通を延々と」は止まらない。
  // 持続的な濫用はアドレス単位の長い窓（OtpPolicy.resendWindowMs、D1 の
  // 行数で判定）が受け持つ。二層で 1 組であって、ここだけでは足りない。
  //
  // `limit` / `period` はコードから読めないので、`Retry-After` に載せる秒数は
  // src/domain/services/rate-limit-policy.ts が持っている。ずれると利用者に
  // 見える形で誤った秒数を返すため、test/rate-limit-config.test.ts で照合する。
  //
  // namespace_id はアカウント内で一意なら任意の値でよい（D1 のような
  // 払い出しは不要）。**使い回すと別のエンドポイントとカウンタを共有する。**
  "ratelimits": [
    { "name": "RL_EMAIL_START", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_EMAIL_VERIFY", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_LOGIN_VERIFY", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
  ],

  // 保持期限を過ぎた行の掃除（#43、仕様書 7.3）。src/index.ts の scheduled が受ける。
  //
  // **式は 1 本だけにする。** テーブルごとに Cron を分けると、片方だけ
  // 止まっていても誰も気づかない。保持期間の違いは
  // domain/services/retention-policy.ts が吸収する。
  //
  // 15 分間隔は、1 回の上限（1 テーブル 1,000 行）と対になっている。
  // 1 テーブルあたり 1 日 96,000 行を処理できる計算で、想定する流入量を上回る。
  // 間隔を変えるときは retention-policy.ts の RETENTION_SWEEP_LIMIT の
  // コメントも一緒に直すこと。

  // 監査ログの退避先（#43 の残件 / #27）。
  //
  // `audit_logs` は 180 日で D1 から消えるが、侵害の発覚は 1 年遅れることが
  // ある。消す前にここへ NDJSON で書き、**書けたことを確認してから**消す
  // （src/infrastructure/archive/r2-archive-sink.ts）。
  //
  // **バケットが無いと `audit_logs` の掃除だけが止まる。** 退避できないまま
  // 消すより溜めるほうがよい、という判断。`retention sweep` の failed に
  // audit_logs が出続けるので、気づかないまま進むことはない。
  //
  // Worker から R2 を触るのに S3 の認証情報は要らない。バケットは
  // `wrangler r2 bucket create u18-identity-archive` で作る（runbook 2.x）。
  // **公開しないこと。** 監査ログには ip_hash と user_agent が入っている。
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "u18-identity-archive" }],

  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // 本番 Issuer は未決定（仕様書 14-1）。ローカル既定値として wrangler dev の URL を使う。
    "ISSUER": "http://localhost:8787",
    "RP_ID": "localhost",
    "RP_NAME": "u18 Identity",
    "WEBAUTHN_ORIGIN": "http://localhost:8787",
    // OTP の送信元。ドメインは Email Service 側で検証済みである必要がある（#33 待ち）。
    "EMAIL_FROM": "no-reply@localhost",
    "ENVIRONMENT": "development",
  },

  // 本番用の上書き。`wrangler deploy --env production` で使う。
  // このとき Worker 名は "u18-auth-production" に派生する。
  // dashboard-worker の env.production の Service Binding はこの名前を指している。
  //
  // この env を作らずに deploy すると ENVIRONMENT が "development" のまま乗り、
  // ConsoleEmailSender が OTP をログへ出し、Cookie から __Host- と Secure が外れ、
  // Discovery が localhost を広告する。既定値が安全側ではないので、
  // 本番は必ずこの env 経由でデプロイすること。
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "IDENTITY_DB",
          "database_name": "u18-identity",
          "database_id": "b63c7ee9-42d8-40f2-8f02-e6b5b867eb55",
          "migrations_dir": "../../packages/db/drizzle",
        },
      ],
      // 既定 env 側のコメントを参照（onboarding と Workers Paid が前提）。
      "send_email": [{ "name": "EMAIL" }],

      // ratelimits も継承されない（wrangler のスキーマに明記がある）。
      // ここを書き忘れると**本番だけレート制限が無い**状態になり、しかも
      // binding が無いので 429 ではなく 500 になる。/health は影響を受けない
      // ので、#66 のデプロイ後スモークテストでは気づけない。
      "ratelimits": [
        {
          "name": "RL_EMAIL_START",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "RL_EMAIL_VERIFY",
          "namespace_id": "1002",
          "simple": { "limit": 15, "period": 60 },
        },
        {
          "name": "RL_LOGIN_VERIFY",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 },
        },
      ],

      // env ごとの設定は継承されないので、本番にも明示的に書く（#43）。
      // ここを書き忘れると、本番だけ掃除が走らないまま D1 が増え続け、
      // 容量上限に達した時点で監査ログが静かに欠落し始める。
      "triggers": { "crons": ["*/15 * * * *"] },

      // r2_buckets も継承されない。書き忘れると本番だけ退避先が無くなり、
      // audit_logs の掃除が止まって溜まり続ける（上記の既定値と同じ理由）。
      "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "u18-identity-archive" }],

      // auth と dashboard を**同一ホストに載せ、パスで分ける**（#33）。
      //
      // セッション Cookie は __Host- 接頭辞を使っており、Domain 属性を
      // 付けられない。つまり発行したホストにしか送られないので、
      // dashboard を別ホストに置くと dashboard からセッションを読めない
      // （packages/contracts/src/session-cookie.ts の選択肢 1）。
      // より狭い route を持つ dashboard 側が /account/* を先に拾う。
      "routes": [{ "pattern": "auth.under18.dev/*", "zone_name": "under18.dev" }],

      "vars": {
        // 仕様書 14-1 の決定（#33）。
        //
        // Issuer は OIDC の `iss` としてトークンに焼き込まれ、後から変えると
        // 発行済み ID Token とクライアント設定が一斉に壊れる。ここを動かさない前提で選ぶ。
        "ISSUER": "https://auth.under18.dev",

        // RP ID は issuer のホストではなく登録可能ドメインにする。
        //
        // RP ID を "auth.under18.dev" に固定すると、将来 IdP のホスト名を
        // 変えた瞬間に登録済み Passkey が全て使えなくなる（RP ID は
        // Credential に焼き付くため移行できない）。ゾーンを RP ID にしておけば
        // ホストの移動に耐える。
        //
        // 広げた分の安全性は WEBAUTHN_ORIGIN 側で担保する。*.under18.dev の
        // 任意のページが rpId=under18.dev で assertion を取ること自体は防げないが、
        // その assertion の origin は取得元ホストになるので、下の origin を
        // 厳密一致で検証していれば auth-worker は受け付けない。
        "RP_ID": "under18.dev",
        "RP_NAME": "u18 Identity",
        // Passkey の検証で完全一致を要求する origin。RP ID と違いここは絞る。
        "WEBAUTHN_ORIGIN": "https://auth.under18.dev",
        // Cloudflare Email Sending の送信元。このドメインは Cloudflare 側で
        // 検証済みでなければ送信が失敗する（#35）。
        "EMAIL_FROM": "no-reply@under18.dev",
        "ENVIRONMENT": "production",
      },
    },
  },

  // Secrets（`wrangler secret put` で設定。wrangler.jsonc には書かない）:
  //   SIGNING_KEY_JWK   ID Token 署名用の秘密鍵 (JWK JSON)
  //   SIGNING_KEY_KID   上記鍵の kid
  //   IP_HASH_PEPPER    IP アドレスのハッシュ化に使う pepper
  //
  // メール送信は Cloudflare Email Sending のバインディング経由なので、
  // API キーの Secret は持たない（#35）。
}
