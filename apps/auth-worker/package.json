{
  "name": "@u18/auth-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-client.mjs && wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build-client.mjs && wrangler deploy --dry-run --outdir dist",
    "typecheck": "node scripts/build-client.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node scripts/build-client.mjs && vitest run",
    "test:watch": "node scripts/build-client.mjs && vitest",
    "cf-typegen": "wrangler types",
    "client:create": "node scripts/oauth-client.mjs create",
    "client:disable": "node scripts/oauth-client.mjs disable",
    "client:list": "node scripts/oauth-client.mjs list",
    "client:seed-dev": "node scripts/oauth-client.mjs seed-dev",
    "admin:status": "node scripts/admin-role.mjs status",
    "admin:grant": "node scripts/admin-role.mjs grant",
    "admin:revoke": "node scripts/admin-role.mjs revoke",
    "key:generate": "node scripts/signing-key.mjs generate",
    "key:list": "node scripts/signing-key.mjs list",
    "key:verify": "node scripts/signing-key.mjs verify",
    "key:register": "node scripts/signing-key.mjs register",
    "key:activate": "node scripts/signing-key.mjs activate",
    "key:retire": "node scripts/signing-key.mjs retire",
    "migrate:local": "wrangler d1 migrations apply u18-identity --local",
    "migrate:remote": "wrangler d1 migrations apply u18-identity --remote",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "@u18/contracts": "workspace:*",
    "@u18/db": "workspace:*",
    "@u18/domain": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@u18/testing": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
