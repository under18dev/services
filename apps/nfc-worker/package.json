{
  "name": "@u18/nfc-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-client.mjs && wrangler dev",
    "deploy": "wrangler deploy",
    "build": "node scripts/build-client.mjs && wrangler deploy --dry-run --outdir dist",
    "typecheck": "node scripts/build-client.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "node scripts/build-client.mjs && vitest run",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply u18-nfc --local",
    "migrate:remote": "wrangler d1 migrations apply u18-nfc --remote",
    "build:client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@u18/contracts": "workspace:*",
    "@u18/web-ui": "workspace:*",
    "@u18/domain": "workspace:*",
    "@u18/nfc-db": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@cloudflare/vitest-plugin": "1.4.7",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "@u18/testing": "workspace:*"
  }
}
