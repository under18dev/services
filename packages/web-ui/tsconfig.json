{
  "extends": "../config/tsconfig.lib.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // **`src/client/**` は入れない。** あそこはブラウザでしか動かず DOM 型が要る。
  // この package は Worker 側からも読まれるので、DOM を lib に足すと
  // サーバーのコードが `window` を触れるようになる。型検査は各アプリの
  // `tsconfig.client.json`（DOM を持つ）が行う。
  // `src/kiwa/**` は入れる。あちらはサーバーで描く JSX で DOM を触らない。
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/kiwa/*.ts",
    "src/kiwa/*.tsx",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
