{
  "extends": "../config/tsconfig.lib.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // `scripts/lib/gdg-dark-media.mjs`（GDG デザイン移行 PR1）を
    // `test/gdg-dark-media.test.ts` から読むため。`// @ts-check` を付けた
    // ファイルだけ検査され、他の `.js`/`.mjs` 全部が対象になるわけではない
    // （`checkJs` は立てていない）。
    "allowJs": true
  },
  // **`src/client/**` は入れない。** あそこはブラウザでしか動かず DOM 型が要る。
  // この package は Worker 側からも読まれるので、DOM を lib に足すと
  // サーバーのコードが `window` を触れるようになる。型検査は各アプリの
  // `tsconfig.client.json`（DOM を持つ）が行う。
  // `src/kiwa/**` は入れる。あちらはサーバーで描く JSX で DOM を触らない。
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/kiwa/*.ts",
    "src/kiwa/*.tsx",
    "scripts/**/*.mjs",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
