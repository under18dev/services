{
  "name": "u18-identity",
  "private": true,
  "version": "0.1.0",
  "description": "u18 Identity - OpenID Connect Identity Provider on Cloudflare Workers",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @u18/auth-worker dev",
    "dev:dashboard": "pnpm --filter @u18/dashboard-worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "cf-typegen": "pnpm -r --filter \"./apps/*\" cf-typegen",
    "db:generate": "pnpm --filter @u18/db generate",
    "db:migrate:local": "pnpm --filter @u18/auth-worker migrate:local",
    "db:migrate:remote": "pnpm --filter @u18/auth-worker migrate:remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
