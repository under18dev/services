{
  "name": "u18-identity",
  "private": true,
  "version": "0.1.0",
  "description": "u18 Identity - OpenID Connect Identity Provider on Cloudflare Workers",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @u18/auth-worker dev",
    "dev:dashboard": "pnpm --filter @u18/dashboard-worker dev",
    "dev:nfc": "pnpm --filter @u18/nfc-worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:eslint && pnpm lint:format && pnpm check:bindings && pnpm check:routes && pnpm check:shell && pnpm check:codeql && pnpm check:test-ips && pnpm check:webauthn && pnpm check:asset-pages && pnpm check:app-catalog",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "check:bindings": "node scripts/check-service-bindings.mjs",
    "check:routes": "node scripts/check-route-patterns.mjs",
    "check:deadlines": "node scripts/check-deadlines.mjs",
    "check:issue-refs": "node scripts/check-issue-refs.mjs",
    "check:shell": "node scripts/check-shell-exit-status.mjs",
    "check:codeql": "node scripts/check-codeql-refs.mjs",
    "check:test-ips": "node scripts/check-test-ip-ranges.mjs",
    "check:webauthn": "node scripts/check-webauthn-origin.mjs",
    "check:asset-pages": "node scripts/check-asset-probe-pages.mjs",
    "check:app-catalog": "node scripts/check-app-catalog-routes.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "cf-typegen": "pnpm -r --filter \"./apps/*\" cf-typegen",
    "db:generate": "pnpm --filter @u18/db generate && pnpm --filter @u18/nfc-db generate",
    "db:migrate:local": "pnpm --filter @u18/auth-worker migrate:local",
    "db:migrate:remote": "pnpm --filter @u18/auth-worker migrate:remote",
    "db:migrate:local:nfc": "pnpm --filter @u18/nfc-worker migrate:local",
    "db:migrate:remote:nfc": "pnpm --filter @u18/nfc-worker migrate:remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
